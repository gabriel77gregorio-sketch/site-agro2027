---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo.png';
import { site, telUrl } from '../config/site';

const links = [
  { href: '#moda-country', label: 'Moda Country' },
  { href: '#setores', label: 'Setores' },
  { href: '#sobre', label: 'A Loja' },
  { href: '#visite', label: 'Onde Estamos' },
];
---

<header class="header">
  <div class="container bar">
    <a href="#topo" class="brand" aria-label={`${site.name} - início`}>
      <Image src={logo} alt="" width={112} height={112} quality={95} class="brand-logo" loading="eager" />
      <span class="brand-text">
        <strong>Agro São José</strong>
        <small>Santo Antônio do Jardim</small>
      </span>
    </a>

    <nav id="menu" class="nav" aria-label="Menu principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={telUrl} class="btn btn-gold nav-call"><Icon name="phone-call" variant="fill" /> {site.phoneDisplay}</a>
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--green-900);
    color: #fff;
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.3);
    transition: box-shadow 0.3s, background 0.3s;
  }
  .header.scrolled {
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.45);
  }
  .brand-logo {
    transition: transform 0.4s;
  }
  .brand:hover .brand-logo {
    transform: rotate(-8deg) scale(1.08);
  }
  .bar {
    transition: min-height 0.3s;
  }
  .scrolled .bar {
    min-height: 58px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .brand-logo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 1.2rem;
  }
  .brand-text small {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    background: var(--green-900);
    padding: 0.5rem 1.25rem 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }
  .nav.open {
    display: flex;
  }
  .nav a:not(.btn) {
    padding: 0.9rem 0;
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .nav-call {
    margin-top: 1rem;
  }

  .burger {
    display: grid;
    gap: 5px;
    padding: 12px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .burger span {
    display: block;
    width: 26px;
    height: 3px;
    border-radius: 2px;
    background: #fff;
  }

  @media (min-width: 900px) {
    .burger {
      display: none;
    }
    .nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1.6rem;
      padding: 0;
      border: 0;
      background: none;
    }
    .nav a:not(.btn) {
      padding: 0.3rem 0;
      border: 0;
    }
    .nav a:not(.btn):hover {
      color: var(--gold);
    }
    .nav-call {
      margin: 0;
      min-height: 44px;
      padding-inline: 1.2rem;
    }
    .brand-logo {
      width: 56px;
      height: 56px;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');
  const toggle = (open: boolean) => {
    menu?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  };
  btn?.addEventListener('click', () => toggle(!menu?.classList.contains('open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
</script>
